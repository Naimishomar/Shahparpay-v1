{
  "expo": {
    "name": "Shahparpay",
    "slug": "shahparpay-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shahparpay.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "package": "com.shahparpay.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./src/assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Shahparpay records your shop location with every AEPS and DMT transaction, as required by NPCI."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shahparpay needs your photo library to attach deposit slips and your profile photo.",
          "cameraPermission": "Shahparpay needs the camera to photograph deposit slips and KYC documents."
        }
      ],
      "./plugins/withRdServiceQueries"
    ],
    "scheme": "shahparpay",
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}