{
  "expo": {
    "name": "Shahparpay",
    "slug": "shahparpay-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shahparpay.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon-adaptive.png",
        "backgroundColor": "#FAFAFA"
      },
      "package": "com.shahparpay.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./src/assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Shahparpay records your shop location with every AEPS and DMT transaction, as required by NPCI."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shahparpay needs your photo library to attach deposit slips and your profile photo.",
          "cameraPermission": "Shahparpay needs the camera to photograph deposit slips and KYC documents."
        }
      ],
      "./plugins/withRdServiceQueries",
      "./plugins/withAndroidAbis",
      "./plugins/withPaysprintMatm",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.example.matm.** { *; }\n-keep class com.finopaytech.** { *; }\n-keep class com.anfu.** { *; }\n-keep class de.greenrobot.** { *; }\n-keepclassmembers class * { @org.greenrobot.eventbus.Subscribe <methods>; }\n-dontwarn com.finopaytech.**\n-dontwarn com.anfu.**\n-dontwarn retrofit2.**\n-dontwarn okhttp3.**"
          }
        }
      ]
    ],
    "scheme": "shahparpay",
    "extra": {
      "eas": {
        "projectId": "a389186d-6781-493e-b47b-fb4d23c76cb0"
      }
    },
    "owner": "naimishomar",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a389186d-6781-493e-b47b-fb4d23c76cb0"
    }
  }
}
