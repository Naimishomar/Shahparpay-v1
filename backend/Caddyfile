{
	servers {
		# Cloudflare proxies api.shahparpay.com, so every request arrives from a
		# Cloudflare address. Trust only Cloudflare's published ranges
		# (https://www.cloudflare.com/ips/) and take the visitor's address from
		# CF-Connecting-IP, or the per-IP rate limits would count every retailer
		# as one client. From any other address the header is ignored.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Caddy fetches and renews the Let's Encrypt cert for this name on its own,
# which is why there is no certbot cron anywhere. Port 80 must stay open in the
# security group or the ACME HTTP challenge fails and renewal stops silently.
# Behind Cloudflare, SSL/TLS mode must be "Full (strict)" so Cloudflare talks
# HTTPS to this certificate.
api.shahparpay.com {
	reverse_proxy backend-api:3000 {
		# The real visitor (see trusted_proxies above), as the only hop, so
		# Express (trust proxy 1) and the activity log both read it.
		header_up X-Forwarded-For {client_ip}
	}
}
